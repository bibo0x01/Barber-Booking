{
    "name": "barber-booking-api",
    "version": "1.0.0",
    "private": true,
    "description": "Backend foundation for the barber booking application",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "test": "node scripts/test-database.mjs test",
        "test:db:create": "node scripts/test-database.mjs create",
        "test:db:verify": "node scripts/test-database.mjs verify",
        "test:db:deploy": "node scripts/test-database.mjs deploy",
        "test:db:status": "node scripts/test-database.mjs status",
        "test:gallery": "node scripts/test-database.mjs gallery",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@prisma/client": "^6.16.0",
        "bcrypt": "^6.0.0",
        "cors": "^2.8.5",
        "dotenv": "^17.2.2",
        "express": "^5.1.0",
        "firebase-admin": "^14.5.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "socket.io": "^4.8.4",
        "swagger-ui-express": "^5.0.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@apidevtools/swagger-parser": "^13.1.0",
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.5.2",
        "@types/supertest": "^7.2.1",
        "@types/swagger-ui-express": "^4.1.8",
        "prisma": "^6.16.0",
        "socket.io-client": "^4.8.4",
        "supertest": "^7.3.0",
        "tsx": "^4.20.5",
        "typescript": "^5.9.2"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    }
}
